{
  "name": "pfp-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "demo:traits": "tsx scripts/make-demo-traits.ts",
    "render:sample": "tsx scripts/render-sample.ts",
    "seed:test": "tsx scripts/seed-test-projects.ts",
    "seed:traits": "tsx scripts/seed-trait-pack.ts",
    "verify:roll": "tsx scripts/verify-roll.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "grammy": "1.45.1",
    "pg": "8.23.0",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
