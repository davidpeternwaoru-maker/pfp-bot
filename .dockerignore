# Never let a secret into a build context. The image would carry it forever,
# in a layer, readable by anyone who pulls it.
.env
.env.*
!.env.example

# Database dumps. Every member row, every claim, every wallet address this
# project has ever recorded. The build context is uploaded whole to a remote
# builder, so leaving these in would send the entire database over the wire and
# into a cache nobody here controls — whether or not any COPY line names them.
backups

node_modules
dist
coverage
output
.git
.github

# Regenerated inside the build, so a stale local copy must not shadow it.
src/generated

tests
demo-traits
*.tsbuildinfo
.DS_Store
Thumbs.db
