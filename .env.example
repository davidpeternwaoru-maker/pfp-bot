# Keys only. Never commit values.
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
NODE_ENV=
# Optional. One of: debug, info, warn, error. Defaults to info.
LOG_LEVEL=
# Optional. Directory holding trait pack artwork. Defaults to trait-packs.
TRAIT_ROOT=

# Note: put sslmode=verify-full in DATABASE_URL, not sslmode=require.
# node-postgres treats 'require' as 'verify-full' today but will adopt weaker
# libpq semantics in pg v9, which encrypts without verifying the certificate.

# Optional. Where claimed artwork is written. Defaults to output/claims.
CLAIM_ROOT=

# Optional. Who may issue an award, as "platform:id" entries, e.g.
# telegram:8853090779,discord:4711. Empty means nobody is authorised.
ADMIN_IDS=

# Optional, and set together or not at all. Wallet linking gates token features
# only — claiming works with neither of these present.
#
# Solana JSON-RPC endpoint, including whatever key your provider puts in it.
# For Helius this is https://mainnet.helius-rpc.com/?api-key=<your key>
# https only: the key travels inside this URL.
SOLANA_RPC_URL=
# Where members reach this process from a browser, e.g. https://pfp.example.com
# The signing page is served from here, so wallets require https — except on
# localhost, which browsers already treat as a secure context. Use
# http://localhost:3000 while developing.
PUBLIC_BASE_URL=

# Optional. Port for the signing page and health checks. Defaults to 3000.
HTTP_PORT=
