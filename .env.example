# Keys only. Never commit values.
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
NODE_ENV=
# Optional. One of: debug, info, warn, error. Defaults to info.
LOG_LEVEL=
# Optional. Directory holding trait pack artwork. Defaults to trait-packs.
TRAIT_ROOT=

# Note: put sslmode=verify-full in DATABASE_URL, not sslmode=require.
# node-postgres treats 'require' as 'verify-full' today but will adopt weaker
# libpq semantics in pg v9, which encrypts without verifying the certificate.

# Optional. Where claimed artwork is written. Defaults to output/claims.
CLAIM_ROOT=

# Optional. Who may issue an award, as "platform:id" entries, e.g.
# telegram:8853090779,discord:4711. Empty means nobody is authorised.
ADMIN_IDS=
