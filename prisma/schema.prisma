// Prisma 7 requires an explicit generator output; ESM to match the app.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  draft
  live
  closed
}

/// Which front end an identity belongs to. Members are identified by their
/// platform and that platform's own user id, so a Discord or web front end can
/// be added without the schema having to pretend its users are Telegram users.
enum Platform {
  telegram
  discord
  web
}

/// How a claim's artwork came to exist. Not a variation of one thing: the
/// three have different economics, different ownership and different rules.
///
/// This records production, not selection. A hand-awarded legendary is still
/// `open` because it was composited from trait rows — what makes it an award
/// is its tier and its null memberSlotKey, not its artwork. The invariant that
/// buys is exact: claimType is `open` if and only if traitIds is non-empty.
enum ClaimType {
  /// Composited from trait images. The open pool, and awards drawn from it.
  open
  /// A single pre-rendered artwork the project awards. Transferable, and it
  /// counts toward rarity like any other claim.
  bespoke
  /// A single pre-rendered artwork commissioned by and personal to one member.
  /// Never transferable, and never counted in rarity or supply.
  custom
}

/// Where a commission has got to.
///
/// Payment comes before approval, which is what makes a decline owe a refund.
/// The alternative — approve first, then charge — spares the refund but means
/// an operator commits to work before knowing they will be paid for it.
enum CommissionStatus {
  /// Brief submitted, nothing owed yet by anyone.
  awaiting_payment
  /// Paid, sitting in the operator queue. Nothing is produced from here
  /// without a deliberate approval.
  awaiting_approval
  /// Operator said yes. Work has not started.
  approved
  /// Work has started. Distinct from approved so a member waiting can tell
  /// the difference between being accepted and being drawn.
  in_production
  /// Artwork issued as a custom claim. Terminal.
  delivered
  /// Refused. Terminal, and owes a refund.
  declined
  /// Withdrawn before payment. Terminal, owes nothing.
  cancelled
}

/// Why a commission was refused.
///
/// A fixed list rather than free text, and that is the whole design of the
/// approval gate: the operator taps one of these and the member is told
/// automatically. An operator composing a decline is an operator negotiating,
/// and this system exists so that never happens.
enum DeclineReason {
  /// Third-party characters, logos, or anything else somebody else owns.
  copyrighted_material
  /// A real person's face or likeness.
  real_person
  /// Offensive, hateful, or sexual content.
  prohibited_content
  /// Branding belonging to another project.
  rival_branding
  /// Understood, allowed, and simply not drawable as described.
  not_producible
  /// The brief could not be understood well enough to produce.
  brief_unclear
}

enum TraitTier {
  open
  gated
  legendary
}

/// A community running its own artwork pack and claim window.
model Project {
  id                Int           @id @default(autoincrement())
  name              String
  /// The deep link payload. Unique because it is the only thing resolving an
  /// inbound /start to a project, and it is attacker-supplied.
  slug              String        @unique
  mascotName        String
  status            ProjectStatus @default(draft)
  claimOpensAt      DateTime?
  claimClosesAt     DateTime?
  canvasWidth       Int
  canvasHeight      Int
  /// Where a claim is announced, as an opaque id the announcing front end
  /// understands: a Telegram group id, a Discord channel id, a webhook key.
  /// Text rather than a number because not every platform uses integers.
  announceChannelId String?
  announceOnClaim   Boolean       @default(false)
  eligibilityRule   Json          @default("{}")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  traits             Trait[]
  exclusions         Exclusion[]
  claims             Claim[]
  commissionSettings CommissionSettings?
  commissions        Commission[]
  commissionWaitlist CommissionWaitlist[]
}

/// One artwork layer option, e.g. slot "eyes", name "visor".
model Trait {
  id           Int       @id @default(autoincrement())
  projectId    Int
  slot         String
  name         String
  layerOrder   Int
  imagePath    String
  rarityWeight Int       @default(1)
  tier         TraitTier @default(open)
  createdAt    DateTime  @default(now())

  project            Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  exclusionsAsTraitA Exclusion[] @relation("ExclusionTraitA")
  exclusionsAsTraitB Exclusion[] @relation("ExclusionTraitB")

  // A slot cannot offer the same option twice, and imports are re-runnable.
  @@unique([projectId, slot, name])
  @@index([projectId, slot])
}

/// A pair of traits that may never appear together in one combination.
model Exclusion {
  id        Int @id @default(autoincrement())
  projectId Int
  traitAId  Int
  traitBId  Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  traitA  Trait   @relation("ExclusionTraitA", fields: [traitAId], references: [id], onDelete: Cascade)
  traitB  Trait   @relation("ExclusionTraitB", fields: [traitBId], references: [id], onDelete: Cascade)

  @@unique([projectId, traitAId, traitBId])
  @@index([projectId])
}

/// A Telegram user. Only the identifiers needed to route a claim are stored.
model Member {
  id             Int       @id @default(autoincrement())
  platform       Platform
  /// The platform's own id for this person, kept as text: Telegram and Discord
  /// both use 64-bit integers, but a web identity is just as likely to be a
  /// UUID, and text is the only shape that holds all of them without loss.
  externalId     String
  /// Display handle on that platform. A convenience only — it changes freely.
  handle         String?
  firstSeenAt    DateTime  @default(now())
  /// The Solana address this member has proved they control, base58.
  ///
  /// Unique, and that constraint is the whole point: without it one holder
  /// verifies once and passes the address round the community, and every
  /// token gate in the product is open to everyone. Nullable because linking
  /// is optional — Postgres treats nulls as distinct, so any number of members
  /// may have none.
  ///
  /// Only ever written after a signature has been verified server-side. A
  /// typed address proves nothing and must never reach this column.
  walletAddress  String?   @unique
  /// When the current address was proved. Cleared on unlink.
  walletLinkedAt DateTime?

  claims             Claim[]
  challenges         WalletChallenge[]
  commissions        Commission[]
  commissionWaitlist CommissionWaitlist[]

  // One row per identity per platform. The same person arriving through two
  // front ends is two members until something deliberately links them, which
  // is the honest default: nothing here can prove they are the same person.
  @@unique([platform, externalId])
}

/// A permanently locked combination held by one member.
model Claim {
  id        Int @id @default(autoincrement())
  projectId Int
  memberId  Int

  /// Stored as an array rather than a join table: a claimed combination is
  /// immutable and is hashed as a single unit, so it has no independent rows.
  /// Empty for bespoke and custom claims: a one-of-one artwork has no
  /// combination, and inventing trait ids for it would put artwork in rarity
  /// counts that was never composited from traits.
  traitIds        Int[]
  combinationHash String
  editionNumber   Int
  claimType       ClaimType @default(open)
  tier            TraitTier @default(open)
  /// False only for custom claims. The on-chain phase reads this to decide
  /// mint parameters; nothing off-chain depends on it yet.
  transferable    Boolean   @default(true)
  imagePath       String
  contentHash     String
  /// "<memberId>:open" for a rolled claim, "<memberId>:custom" for a
  /// commissioned one, and null for anything a project hands out.
  ///
  /// Null is what scopes the unique index below: Postgres treats nulls as
  /// distinct, so a member may hold any number of awarded claims, but only one
  /// rolled claim and only one commissioned claim per project. Encoding the
  /// type into the key is what lets those two coexist rather than collide.
  /// Set in exactly one place, insertClaim.
  memberSlotKey   String?
  /// Reserved for a later on-chain phase. Unused, never written to for now.
  mintAddress     String?
  claimedAt       DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Without this, two members can hold the identical artwork. The product's
  // entire premise — that your PFP is yours alone — dies at the first duplicate.
  @@unique([projectId, combinationHash])
  // One rolled claim and one commissioned claim per member per project.
  // Without it, one member can claim repeatedly and drain the open pool,
  // making "one per member" a promise the code cannot keep.
  //
  // The scoping is carried by memberSlotKey above rather than by a partial
  // index: a partial index is not expressible here, so it would live only in
  // raw migration SQL, and `prisma migrate dev` regenerates migrations and
  // discards it — leaving no enforcement at all, silently.
  @@unique([projectId, memberSlotKey])
  // Without this, concurrent claims can be assigned the same edition number,
  // so "#7 of 500" stops identifying anything.
  @@unique([projectId, editionNumber])
  @@index([projectId, memberId])
  @@index([memberId])
}

/// A one-time challenge a member signs to prove they control a wallet.
///
/// Rows are kept after use rather than deleted: `consumedAt` is what makes a
/// replayed signature detectable, and a deleted row is indistinguishable from
/// one that never existed.
model WalletChallenge {
  id       Int @id @default(autoincrement())
  memberId Int

  /// The opaque value that appears in the signing page URL.
  ///
  /// Separate from the nonce, and never the member id. A URL travels through
  /// browser history, referrer headers and whatever is looking over a
  /// shoulder; the member id would identify a person to anybody who saw it,
  /// and would be guessable enough to try.
  token String @unique
  /// The value embedded in the message that gets signed.
  nonce String

  expiresAt  DateTime
  /// Set exactly once, by a conditional update. See consumeChallenge.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Rate limiting and the "how many has this member started" question.
  @@index([memberId, createdAt])
  // Expired rows are swept by age.
  @@index([expiresAt])
}

/// Whether a project sells commissions, and on what terms.
///
/// Separate from Project because it is optional and detailed: most projects
/// never sell one, and folding a dozen nullable columns into Project would
/// make the common case carry the cost of the rare one.
model CommissionSettings {
  id        Int @id @default(autoincrement())
  projectId Int @unique

  /// Off by default. A project that has not yet decided its price, capacity
  /// and what it will refuse should not be quietly open for orders.
  enabled Boolean @default(false)

  /// Price in USDC cents. An integer rather than a float because money that
  /// rounds is money somebody argues about, and rather than Decimal because
  /// two places is all a price needs and Int needs no decimal library.
  priceUsdcCents Int @default(0)

  /// Share of each commission owed to the project, in basis points, so 12.5%
  /// is expressible. Copied onto each order at order time; see Commission.
  treasuryShareBps Int @default(0)

  /// Commissions accepted per calendar month. Zero means none.
  monthlyCapacity Int @default(0)

  /// Optional token gate. Both or neither: a mint with no threshold gates on
  /// nothing, and a threshold with no mint has nothing to measure.
  tokenMint    String?
  /// Minimum holding in human units, e.g. "1000" or "0.5". Text rather than a
  /// number so it is scaled against the mint's real decimals, never a float.
  tokenMinimum String?

  /// Which slots a member may commission. Empty means none are eligible.
  eligibleSlots String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// One member's order for personalised artwork.
model Commission {
  id        Int @id @default(autoincrement())
  projectId Int
  memberId  Int

  status CommissionStatus @default(awaiting_payment)

  /// Price and treasury share are copied from settings at order time rather
  /// than read live. Accounting has to survive a project changing its price:
  /// a payable report that recomputed from current settings would silently
  /// restate what was owed on orders already paid for.
  priceUsdcCents   Int
  treasuryShareBps Int

  /// Operator-recorded payment reference, e.g. a transaction signature. Free
  /// text because a human transcribes it from a wallet, and validating a
  /// shape this system does not verify on chain would only pretend to check.
  paymentReference String?
  paidAt           DateTime?

  declineReason DeclineReason?

  approvedAt DateTime?
  startedAt  DateTime?
  declinedAt DateTime?

  /// The claim produced. Null until delivery, and set exactly once.
  deliveredClaimId Int?      @unique
  deliveredAt      DateTime?

  /// Set when the refund a decline owes has been paid. Null while it is still
  /// owed, which is exactly what the payable report reads.
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  briefs  CommissionBrief[]

  /// "<memberId>" while the order is live, null once it is finished.
  ///
  /// Postgres treats nulls as distinct, so this enforces one live order per
  /// member per project while letting any number of finished ones sit beside
  /// it. Two open orders is one member holding two people's worth of a
  /// capacity the project promised to everybody.
  openOrderKey String?

  @@unique([projectId, openOrderKey])
  // The monthly capacity count and the operator queue both read this.
  @@index([projectId, status, createdAt])
  @@index([memberId])
}

/// What a member asked for, as answers to a fixed questionnaire.
///
/// Never a blank text box. A vague brief is what creates conversation, and
/// conversation is what this whole design exists to eliminate — so every field
/// is either chosen from a list or hard length-limited.
model CommissionBrief {
  id           Int @id @default(autoincrement())
  commissionId Int

  /// 0 is the original. 1 is the single revision a member is allowed.
  revision Int @default(0)

  /// Which slot is being customised. Checked against the project's eligible
  /// slots at submission.
  slot String

  /// Length-limited and character-set validated at entry, and never rendered
  /// into an image automatically — every commission passes through a human.
  textContent   String?
  /// Chosen from a fixed palette, never a free-form colour value.
  colour        String?
  /// Optional reference image, as a path inside the commission root.
  referencePath String?
  /// Anything else, hard length-limited.
  note          String?

  createdAt DateTime @default(now())

  commission Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  // One brief per revision. The cap is load-bearing: unlimited revisions is
  // how a self-serve system quietly turns into a design argument by proxy.
  @@unique([commissionId, revision])
}

/// Members waiting for capacity to open next month.
model CommissionWaitlist {
  id        Int @id @default(autoincrement())
  projectId Int
  memberId  Int

  createdAt  DateTime  @default(now())
  /// Set once they have been told a slot opened, so nobody is told twice.
  notifiedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([projectId, notifiedAt])
}
